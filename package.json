{
  "name": "neontd",
  "version": "1.0.0",
  "private": true,
  "description": "Неоновый рубеж — браузерная tower defense",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p .",
